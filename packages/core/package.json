{
  "name": "@sukhan/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pure domain logic for Sukhan: FSRS scheduling, curriculum structure, and progress rules. No I/O, no framework, no storage.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "fast-check": "^4.3.0",
    "ts-fsrs": "^5.2.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}

# Copy to `.env.local` and fill in. `.env.local` is gitignored; this file is not.
#
# These are Supabase's *publishable* client credentials. They are visible to
# anyone who loads the app, which is by design — the security boundary is
# Row Level Security on the database, not secrecy of this key. Never put a
# service-role key in a VITE_-prefixed variable: Vite inlines every VITE_* value
# into the client bundle.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
